{
  "routing_engine": {
    "provider": "laya",
    "model_name": "laya-base-english",
    "enabled": false,
    "fallback_to_rules": true
  },
  "cloud_provider": {
    "provider": "gemini",
    "fast_model": "gemini-3.1-flash-lite",
    "high_throughput_model": "gemini-3.5-flash-lite",
    "reasoning_model": "gemini-3.8-flash",
    "worker_model": "gemini-3.5-flash-lite"
  },
  "groq_provider": {
    "provider": "groq",
    "base_url": "https://api.groq.com/openai/v1",
    "default_coding_model": "qwen/qwen3.8-27b",
    "default_reasoning_model": "qwen/qwen3.8-27b",
    "default_planner_model": "openai/gpt-oss-120b"
  },
  "agent_model_mapping": {
    "coder": {"provider": "groq", "model": "qwen/qwen3.8-27b", "tier": "ultra_fast_groq_lpu"},
