{
  "risk_tiers": {
    "read_only": ["read_file", "list_directory", "web_search"],
    "reversible": ["write_file", "fetch_web_page"],
    "irreversible": ["execute_command", "edit_file"]
  },
  "max_command_timeout_seconds": 30,
  "max_write_file_bytes": 1048576,
  "command_blacklist_patterns": [
    "\\brm\\s+-[rf]{1,2}\\s+[/~*]",
    "\\bformat\\s+[a-zA-Z]:",
    "\\bshutdown\\b",
    "\\bmkfs\\b",
    ":\\(\\)\\s*\\{",
    "\\bdd\\s+if="
  ]
}
